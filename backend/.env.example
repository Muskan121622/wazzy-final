# ── Wayzyy TripOS backend environment ──────────────────────────
# Copy to .env for local dev. On Render, set these in the dashboard.

# Database: leave EMPTY to use local SQLite (backend/database/tripos.db).
# For production, create a free Neon/Supabase Postgres DB and paste its URL.
# Render: use the "Internal Database URL" so the app talks to Neon privately.
DATABASE_URL=

# Secret used to sign auth tokens (JWT). CHANGE THIS to a long random string.
SECRET_KEY=change-me-to-a-long-random-secret

# Groq (LLM for the concierge agent). Without it, chat degrades to a safe fallback.
GROQ_API_KEY=

# How often the PROACTIVE watcher sweeps active trips (live weather + closing hours).
MONITOR_INTERVAL_MIN=20

# Comma-separated allowed CORS origins for the frontend.
ALLOWED_ORIGINS=http://localhost:3000,https://hiver.vercel.app,https://wazzy.onrender.com
